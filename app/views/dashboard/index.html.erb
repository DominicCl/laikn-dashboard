<% 
  # Chart Data Builder (Pass raw UTC to JavaScript to handle local timezones)
  chart_data = []
  if @requests.present?
    sorted_history = @requests.to_a.sort_by { |req| req.data[:timestamp].to_time }
    
    chart_data = sorted_history.map do |req|
      { raw_utc: req.data[:timestamp].to_time.iso8601, value: req.data[:carbon_intensity].to_i }
    end
  end
%>

<script src="https://cdn.tailwindcss.com"></script>
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 font-sans bg-slate-50 min-h-screen">
  
  <!-- Header with Logo Only -->
  <div class="mb-10">
    <%= image_tag "FinalLogo.png", height: 60, class: "h-12 w-auto", alt: "Laikn Logo" %>
  </div>

  <!-- HERO STATS ROW -->
  <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
    
    <!-- Routing analyses -->
    <div class="bg-white rounded-2xl shadow-sm border border-slate-100 p-6 flex flex-col justify-center">
      <h3 class="text-xs font-bold text-slate-400 uppercase tracking-widest mb-2">Routing Analyses</h3>
      <div class="text-5xl font-extrabold text-emerald-700 leading-none mb-3">
        <%= @analysis_count || 0 %>
      </div>
      <p class="text-sm text-slate-500">Region comparisons requested from the extension.</p>
    </div>

    <!-- Immediate Routes -->
    <div class="bg-white rounded-2xl shadow-sm border border-slate-100 p-6 flex items-center">
      <div class="p-4 rounded-xl bg-blue-50 text-blue-600">
        <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path></svg>
      </div>
      <div class="ml-5">
        <p class="text-xs font-bold text-slate-400 uppercase tracking-widest">Standard Routes</p>
        <h3 class="text-3xl font-bold text-slate-900 mt-1"><%= @immediate_count || 0 %></h3>
      </div>
    </div>

    <!-- Eco-Patience (Shifted) -->
    <div class="bg-white rounded-2xl shadow-sm border border-slate-100 p-6 flex items-center">
      <div class="p-4 rounded-xl bg-violet-50 text-violet-600">
        <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
      </div>
      <div class="ml-5">
        <p class="text-xs font-bold text-slate-400 uppercase tracking-widest">Workloads Shifted</p>
        <h3 class="text-3xl font-bold text-slate-900 mt-1"><%= @shifted_count || 0 %></h3>
      </div>
    </div>
  </div>

  <!-- CHART SECTION -->
  <div class="bg-white p-6 rounded-2xl shadow-sm border border-slate-100 mb-8">
    <div class="flex justify-between items-center mb-6">
      <h3 class="text-lg font-bold text-slate-800">📉 Real-Time Carbon Intensity (g/kWh)</h3>
      <div class="flex gap-2 items-center">
        <button id="prev-month-btn" class="bg-slate-100 hover:bg-slate-200 text-slate-700 px-4 py-1.5 rounded-full text-sm font-bold transition-colors">← Prev</button>
        <span id="current-month-label" class="font-bold text-emerald-700 px-3 min-w-[120px] text-center">Loading...</span>
        <button id="next-month-btn" class="bg-slate-100 hover:bg-slate-200 text-slate-700 px-4 py-1.5 rounded-full text-sm font-bold transition-colors">Next →</button>
      </div>
    </div>
    <div class="h-72 w-full">
      <canvas id="carbonChart"></canvas>
    </div>
  </div>

  <!-- DECISIONS ACTIVITY FEED -->
  <div class="bg-white rounded-2xl shadow-sm border border-slate-100 overflow-hidden">
    <div class="px-6 py-5 border-b border-slate-100">
      <h3 class="text-lg font-bold text-slate-800">Recent Routing Decisions</h3>
    </div>
    
    <div class="overflow-x-auto">
      <table class="min-w-full divide-y divide-slate-100">
        <thead class="bg-slate-50">
          <tr>
            <th class="px-6 py-4 text-left text-xs font-bold text-slate-400 uppercase tracking-wider">Date</th>
            <th class="px-6 py-4 text-left text-xs font-bold text-slate-400 uppercase tracking-wider">Action Type</th>
            <th class="px-6 py-4 text-left text-xs font-bold text-slate-400 uppercase tracking-wider">Target Region</th>
          </tr>
        </thead>
        <tbody class="bg-white divide-y divide-slate-100">
          <% if @decisions.present? %>
            <% @decisions.each_with_index do |decision, index| %>
              <tr class="history-row hover:bg-slate-50 transition-colors" style="<%= 'display: none;' if index >= 10 %>">
                <!-- Using a data attribute so JavaScript can inject the user's local time -->
                <td class="px-6 py-4 whitespace-nowrap text-sm text-slate-600 font-medium">
                  <span class="local-timestamp" data-utc="<%= decision[:timestamp].to_time.iso8601 %>">
                    Loading...
                  </span>
                </td>
                
                <td class="px-6 py-4 whitespace-nowrap">
                  <% if decision[:decision_type] == 'shifted' || decision[:decision_type] == 'shift_completed' %>
                    <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-bold bg-violet-100 text-violet-700">
                      <svg class="mr-1.5 h-2 w-2 text-violet-500" fill="currentColor" viewBox="0 0 8 8"><circle cx="4" cy="4" r="3" /></svg> Temporal Shift
                    </span>
                  <% elsif decision[:decision_type] == 'ignored' %>
                    <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-bold bg-slate-100 text-slate-500">
                      Ignored Advice
                    </span>
                  <% else %>
                    <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-bold bg-blue-100 text-blue-700">
                      <svg class="mr-1.5 h-2 w-2 text-blue-500" fill="currentColor" viewBox="0 0 8 8"><circle cx="4" cy="4" r="3" /></svg> Immediate Route
                    </span>
                  <% end %>
                </td>
                
                <td class="px-6 py-4 whitespace-nowrap text-sm font-bold text-slate-800">
                  <%= decision[:chosen_option] %>
                </td>
              </tr>
            <% end %>
          <% else %>
            <tr><td colspan="3" class="px-6 py-10 text-center text-sm text-slate-500">No routing decisions recorded yet.</td></tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <!-- TABLE PAGINATION BUTTONS -->
    <% if @decisions.to_a.size > 10 %>
      <div class="flex justify-center gap-4 p-5 bg-slate-50 border-t border-slate-100">
        <button id="view-less-btn" class="hidden bg-slate-400 hover:bg-slate-500 text-white px-6 py-2 rounded-full font-bold text-sm transition-colors">↑ View Less</button>
        <button id="view-more-btn" class="bg-emerald-600 hover:bg-emerald-700 text-white px-6 py-2 rounded-full font-bold text-sm transition-colors">View More ↓</button>
      </div>
    <% end %>
  </div>
</div>

<!-- ================= JAVASCRIPT LOGIC ================= -->

<script>
  // --- TIMEZONE FORMATTER ---
  // Grabs all the UTC timestamps from the table and converts them to the browser's local timezone
  document.querySelectorAll('.local-timestamp').forEach(el => {
    const rawDate = el.getAttribute('data-utc');
    if (rawDate) {
      const date = new Date(rawDate);
      const options = { month: 'short', day: 'numeric', year: 'numeric', hour: '2-digit', minute: '2-digit', hour12: false };
      el.innerText = date.toLocaleString('en-US', options).replace(',', ' •');
    }
  });

  // --- CHART LOGIC ---
  const rawData = <%= raw chart_data.to_json %>;
  
  // Convert UTC to local time for the chart labels
  const allChartData = rawData.map(d => {
    const date = new Date(d.raw_utc);
    const monthStr = date.toLocaleString('en-US', { month: 'long', year: 'numeric' });
    const mm = String(date.getMonth() + 1).padStart(2, '0');
    const dd = String(date.getDate()).padStart(2, '0');
    const hh = String(date.getHours()).padStart(2, '0');
    const min = String(date.getMinutes()).padStart(2, '0');
    
    return {
      month_key: monthStr,
      label: `${mm}/${dd} ${hh}:${min}`,
      value: d.value
    };
  });

  const uniqueMonths = [...new Set(allChartData.map(d => d.month_key))];
  let currentMonthIndex = uniqueMonths.length - 1; 
  
  const ctx = document.getElementById('carbonChart').getContext('2d');
  const carbonChart = new Chart(ctx, {
      type: 'line',
      data: { labels: [], datasets: [{
              label: 'Grid Carbon Intensity',
              data: [], 
              borderColor: '#04703C',
              backgroundColor: 'rgba(4, 112, 60, 0.05)',
              borderWidth: 3,
              pointBackgroundColor: '#fff',
              pointBorderColor: '#04703C',
              pointRadius: 4,
              fill: true,
              tension: 0.4 
          }]
      },
      options: {
          responsive: true, maintainAspectRatio: false,
          plugins: { legend: { display: false } },
          scales: {
              y: { beginAtZero: true, grid: { color: '#f1f5f9', borderDash: [5, 5] } },
              x: { grid: { display: false } }
          }
      }
  });

  function renderChartForMonth(index) {
    if (uniqueMonths.length === 0) {
      document.getElementById('current-month-label').innerText = "No Data";
      return;
    }
    const targetMonth = uniqueMonths[index];
    document.getElementById('current-month-label').innerText = targetMonth;
    const filteredData = allChartData.filter(d => d.month_key === targetMonth);
    
    carbonChart.data.labels = filteredData.map(d => d.label);
    carbonChart.data.datasets[0].data = filteredData.map(d => d.value);
    carbonChart.update();
  }
  renderChartForMonth(currentMonthIndex);

  document.getElementById('prev-month-btn')?.addEventListener('click', () => {
    if (currentMonthIndex > 0) renderChartForMonth(--currentMonthIndex);
  });
  document.getElementById('next-month-btn')?.addEventListener('click', () => {
    if (currentMonthIndex < uniqueMonths.length - 1) renderChartForMonth(++currentMonthIndex);
  });

  // --- TABLE PAGINATION LOGIC ---
  let visibleCount = 10;
  const rows = document.querySelectorAll('.history-row');
  const viewMoreBtn = document.getElementById('view-more-btn');
  const viewLessBtn = document.getElementById('view-less-btn');

  function updateButtons() {
    if (!viewMoreBtn || !viewLessBtn) return;
    viewMoreBtn.style.display = (visibleCount >= rows.length) ? 'none' : 'inline-block';
    viewLessBtn.classList.toggle('hidden', visibleCount <= 10);
  }

  viewMoreBtn?.addEventListener('click', () => {
    let nextCount = Math.min(visibleCount + 10, rows.length);
    for (let i = visibleCount; i < nextCount; i++) rows[i].style.display = 'table-row';
    visibleCount = nextCount;
    updateButtons();
  });

  viewLessBtn?.addEventListener('click', () => {
    let nextCount = Math.max(10, visibleCount - (visibleCount % 10 === 0 ? 10 : visibleCount % 10));
    for (let i = nextCount; i < visibleCount; i++) rows[i].style.display = 'none';
    visibleCount = nextCount;
    updateButtons();
  });
</script>
